# ═══════════════════════════════════════════════════════════════════════════════
# Merchant Payment Operations Intelligence — Environment Configuration
# ═══════════════════════════════════════════════════════════════════════════════
# Copy to .env and fill in your values.

# ── Razorpay ───────────────────────────────────────────────────────────────────
RAZORPAY_KEY_ID=rzp_test_xxxxxxxxxxxx
RAZORPAY_KEY_SECRET=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# ── Claude / Anthropic ─────────────────────────────────────────────────────────
ANTHROPIC_API_KEY=sk-ant-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# ── Database ───────────────────────────────────────────────────────────────────
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/merchant_ops
DATABASE_URL_SYNC=postgresql://postgres:postgres@localhost:5432/merchant_ops

# ── Redis (caching) ───────────────────────────────────────────────────────────
REDIS_URL=redis://localhost:6379/0

# ── Application ────────────────────────────────────────────────────────────────
ENVIRONMENT=development
LOG_LEVEL=INFO
API_HOST=0.0.0.0
API_PORT=8000
DEBUG=true

# ── Notifications (optional) ──────────────────────────────────────────────────
NOTIFICATION_EMAIL=ops@yourcompany.com
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
WEBHOOK_URL=
