{
  "outputDirectory": "public",
  "buildCommand": "echo 'static site - no build needed'",
  "installCommand": "echo 'no install needed'",
  "cleanUrls": true,
  "trailingSlash": false,
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "X-Frame-Options", "value": "DENY" }
      ]
    }
  ]
}
